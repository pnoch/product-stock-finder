{
  "name": "product-stock-finder",
  "version": "5.16.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:metro\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:metro": "cross-env EXPO_USE_METRO_WORKSPACE_ROOT=1 npx expo start --web --port ${EXPO_PORT:-8081}",
    "build": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && pnpm build:web",
    "build:web": "expo export -p web --output-dir dist-web",
    "build:apk": "bash scripts/build-apk.sh",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "expo lint app components lib hooks server shared scripts desktop/src desktop/tests tests -- --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "test:rust": "cargo test --manifest-path desktop/src-tauri/Cargo.toml",
    "verify": "pnpm check && pnpm lint && pnpm test && pnpm check:desktop && pnpm --dir desktop test && pnpm test:rust",
    "smoke:web": "tsx scripts/smoke-web.ts",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "qr": "node scripts/generate_qr.mjs",
    "generate-fixtures": "tsx scripts/generate-fixtures.ts",
    "dev:desktop": "pnpm --filter desktop dev",
    "build:desktop": "pnpm --filter desktop build",
    "check:desktop": "pnpm --filter desktop check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.2",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.90.12",
    "@trpc/client": "11.19.0",
    "@trpc/react-query": "11.19.0",
    "@trpc/server": "11.19.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.3",
    "expo": "~54.0.37",
    "expo-background-task": "~1.0.10",
    "expo-build-properties": "^1.0.10",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-document-picker": "^14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-server-sdk": "^7.1.0",
    "expo-sharing": "^14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.11",
    "express": "^4.22.1",
    "fuse.js": "^7.5.0",
    "jose": "6.1.0",
    "mysql2": "^3.24.4",
    "nativewind": "^4.2.1",
    "playwright": "^1.62.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "superjson": "^1.13.3",
    "tailwind-merge": "^2.6.0",
    "undici": "7.30.0",
    "web-push": "^3.6.7",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.17",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "path-to-regexp@<0.1.13": "0.1.13",
      "undici@>=7.0.0 <7.29.1": "7.30.0",
      "undici@>=6.0.0 <6.28.1": "6.28.1",
      "tar@<=7.5.18": "7.5.22",
      "flatted@<3.4.2": "3.4.2",
      "node-forge@<1.4.0": "1.4.0",
      "ws@<8.21.0": "8.21.0",
      "form-data@<4.0.6": "4.0.6",
      "shell-quote@<=1.8.4": "1.9.0",
      "browserslist@<4.28.7": "4.28.7",
      "js-yaml@<4.3.2": "4.3.2",
      "nanoid@<3.3.18": "3.3.18",
      "rollup@<4.59.0": "4.59.0",
      "vite@<6.4.3": "6.4.3",
      "@xmldom/xmldom@<0.8.15": "0.8.15",
      "postcss@<8.5.23": "8.5.28",
      "fast-uri@<3.1.8": "3.1.8",
      "esbuild@<=0.24.2": "0.25.12",
      "qs@>=6.0.0 <6.16.0": "6.16.0",
      "ajv@>=7.0.0 <8.18.0": "8.20.0",
      "yaml@>=2.0.0 <2.8.3": "2.9.1",
      "@babel/core@<=7.29.0": "7.29.6",
      "body-parser@<1.20.6": "1.20.6",
      "decode-uri-component@<=0.4.2": "0.5.0",
      "postcss-selector-parser@>=6.1.0 <6.1.3": "6.1.3",
      "@humanfs/node@<0.16.8": "0.16.8",
      "uuid@<11.1.1": "11.1.1"
    }
  }
}
