CREATE TABLE saved_product (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL CHECK (length(trim(title)) > 0),
    source_url TEXT,
    saved_at INTEGER NOT NULL
);

CREATE INDEX saved_product_saved_at ON saved_product(saved_at, id);

CREATE TABLE listing (
    id TEXT NOT NULL PRIMARY KEY,
    product_id TEXT NOT NULL REFERENCES saved_product(id) ON DELETE CASCADE,
    source_label TEXT NOT NULL CHECK (length(trim(source_label)) > 0),
    price_minor INTEGER NOT NULL CHECK (price_minor >= 0),
    currency_code TEXT NOT NULL,
    currency_scale INTEGER NOT NULL CHECK (currency_scale BETWEEN 0 AND 4),
    shipping_minor INTEGER CHECK (shipping_minor >= 0),
    taxes_minor INTEGER CHECK (taxes_minor >= 0),
    fees_minor INTEGER CHECK (fees_minor >= 0),
    discount_minor INTEGER NOT NULL CHECK (discount_minor >= 0)
);

CREATE INDEX listing_product_id ON listing(product_id, id);

CREATE TABLE price_observation (
    listing_id TEXT NOT NULL REFERENCES listing(id) ON DELETE CASCADE,
    observed_at INTEGER NOT NULL,
    price_minor INTEGER NOT NULL CHECK (price_minor >= 0),
    currency_code TEXT NOT NULL,
    currency_scale INTEGER NOT NULL CHECK (currency_scale BETWEEN 0 AND 4),
    source TEXT NOT NULL,
    PRIMARY KEY (listing_id, observed_at)
);

CREATE TABLE preference (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

CREATE TABLE purchase_order (
    id TEXT NOT NULL PRIMARY KEY,
    merchant TEXT NOT NULL CHECK (length(trim(merchant)) > 0),
    created_at INTEGER NOT NULL,
    currency_code TEXT,
    currency_scale INTEGER,
    shipping_minor INTEGER,
    tax_minor INTEGER,
    discount_minor INTEGER,
    total_minor INTEGER,
    merchant_order_id TEXT,
    purchased_at INTEGER,
    payment_method_label TEXT
);

CREATE INDEX purchase_order_created_at ON purchase_order(created_at, id);

CREATE TABLE order_item (
    id TEXT NOT NULL PRIMARY KEY,
    order_id TEXT NOT NULL REFERENCES purchase_order(id) ON DELETE CASCADE,
    title TEXT NOT NULL CHECK (length(trim(title)) > 0),
    quantity INTEGER NOT NULL CHECK (quantity > 0),
    unit_price_minor INTEGER,
    UNIQUE (id, order_id)
);

CREATE INDEX order_item_order_id ON order_item(order_id);

CREATE TABLE shipment (
    id TEXT NOT NULL PRIMARY KEY,
    order_id TEXT NOT NULL REFERENCES purchase_order(id) ON DELETE CASCADE,
    tracking_number TEXT NOT NULL,
    carrier_label TEXT NOT NULL,
    status TEXT NOT NULL,
    carrier_id TEXT,
    UNIQUE (id, order_id)
);

CREATE INDEX shipment_order_id ON shipment(order_id);

CREATE TABLE shipment_item (
    shipment_id TEXT NOT NULL,
    order_id TEXT NOT NULL,
    order_item_id TEXT NOT NULL,
    quantity INTEGER NOT NULL CHECK (quantity > 0),
    PRIMARY KEY (shipment_id, order_item_id),
    FOREIGN KEY (shipment_id, order_id) REFERENCES shipment(id, order_id) ON DELETE CASCADE,
    FOREIGN KEY (order_item_id, order_id) REFERENCES order_item(id, order_id) ON DELETE CASCADE
);

CREATE INDEX shipment_item_order_id ON shipment_item(order_id);

CREATE TABLE tracking_event (
    shipment_id TEXT NOT NULL REFERENCES shipment(id) ON DELETE CASCADE,
    source TEXT NOT NULL,
    source_event_id TEXT NOT NULL,
    status TEXT NOT NULL,
    description TEXT NOT NULL,
    method TEXT NOT NULL CHECK (method IN ('MANUAL', 'PROVIDER')),
    imported_at INTEGER NOT NULL,
    occurred_at INTEGER,
    original_timestamp TEXT,
    original_timezone TEXT,
    PRIMARY KEY (shipment_id, source, source_event_id)
);

CREATE INDEX tracking_event_timeline ON tracking_event(shipment_id, imported_at, source_event_id);

saveProduct:
INSERT INTO saved_product VALUES (?, ?, ?, ?);

findProduct:
SELECT * FROM saved_product WHERE id = ?;

savePreference:
INSERT OR REPLACE INTO preference VALUES (?, ?);

findPreference:
SELECT value FROM preference WHERE key = ?;

listProducts:
SELECT * FROM saved_product ORDER BY saved_at DESC, id LIMIT :page_size OFFSET :page_offset;

insertListing:
INSERT INTO listing VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertObservation:
INSERT INTO price_observation VALUES (?, ?, ?, ?, ?, ?);

offersForProducts:
SELECT * FROM listing WHERE product_id IN :product_ids ORDER BY product_id, id;

insertOrder:
INSERT INTO purchase_order VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertOrderItem:
INSERT INTO order_item VALUES (?, ?, ?, ?, ?);

listOrders:
SELECT * FROM purchase_order ORDER BY created_at DESC, id LIMIT :page_size OFFSET :page_offset;

findOrder:
SELECT * FROM purchase_order WHERE id = ?;

findOrderByMerchantId:
SELECT * FROM purchase_order WHERE merchant = ? AND merchant_order_id = ? LIMIT 1;

updateOrderFinancials:
UPDATE purchase_order
SET currency_code = ?, currency_scale = ?, shipping_minor = ?, tax_minor = ?, discount_minor = ?,
    total_minor = ?, merchant_order_id = ?, purchased_at = ?, payment_method_label = ?
WHERE id = ?;

updateOrderItemPrice:
UPDATE order_item SET unit_price_minor = ? WHERE id = ?;

orderItems:
SELECT * FROM order_item WHERE order_id = ? ORDER BY id;

insertShipment:
INSERT INTO shipment VALUES (?, ?, ?, ?, ?, ?);

insertAllocation:
INSERT INTO shipment_item VALUES (?, ?, ?, ?);

orderShipments:
SELECT * FROM shipment WHERE order_id = ? ORDER BY id;

orderAllocations:
SELECT * FROM shipment_item WHERE order_id = ? ORDER BY shipment_id, order_item_id;

findShipment:
SELECT * FROM shipment WHERE id = ?;

updateShipmentStatus:
UPDATE shipment SET status = ? WHERE id = ?;

insertEvent:
INSERT OR IGNORE INTO tracking_event VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

findEvent:
SELECT * FROM tracking_event WHERE shipment_id = ? AND source = ? AND source_event_id = ?;

shipmentEvents:
SELECT * FROM tracking_event WHERE shipment_id = ?
ORDER BY coalesce(occurred_at, imported_at), imported_at, source_event_id;

allProducts:
SELECT * FROM saved_product ORDER BY id;

allListings:
SELECT * FROM listing ORDER BY id;

allObservations:
SELECT * FROM price_observation ORDER BY listing_id, observed_at;

allOrders:
SELECT * FROM purchase_order ORDER BY id;

allOrderItems:
SELECT * FROM order_item ORDER BY id;

allShipments:
SELECT * FROM shipment ORDER BY id;

allAllocations:
SELECT * FROM shipment_item ORDER BY shipment_id, order_item_id;

allEvents:
SELECT * FROM tracking_event ORDER BY shipment_id, source, source_event_id;

allPreferences:
SELECT * FROM preference ORDER BY key;

deleteEvents:
DELETE FROM tracking_event;

deleteAllocations:
DELETE FROM shipment_item;

deleteShipments:
DELETE FROM shipment;

deleteOrderItems:
DELETE FROM order_item;

deleteOrders:
DELETE FROM purchase_order;

deleteObservations:
DELETE FROM price_observation;

deleteListings:
DELETE FROM listing;

deleteProducts:
DELETE FROM saved_product;

deletePreferences:
DELETE FROM preference;

insertEventStrict:
INSERT INTO tracking_event VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

CREATE TABLE order_private (
    order_id TEXT NOT NULL REFERENCES purchase_order(id) ON DELETE CASCADE,
    field TEXT NOT NULL,
    key_version INTEGER NOT NULL,
    nonce BLOB NOT NULL,
    ciphertext BLOB NOT NULL,
    PRIMARY KEY (order_id, field)
);

upsertPrivate:
INSERT OR REPLACE INTO order_private VALUES (?, ?, ?, ?, ?);

findPrivate:
SELECT * FROM order_private WHERE order_id = ? AND field = ?;

allPrivate:
SELECT * FROM order_private ORDER BY order_id, field;

deletePrivate:
DELETE FROM order_private WHERE order_id = ? AND field = ?;

deleteAllPrivate:
DELETE FROM order_private;

CREATE TABLE order_return (
    id TEXT NOT NULL PRIMARY KEY,
    order_id TEXT NOT NULL REFERENCES purchase_order(id) ON DELETE CASCADE,
    order_item_id TEXT NOT NULL,
    quantity INTEGER NOT NULL CHECK (quantity BETWEEN 1 AND 2147483647),
    reason TEXT NOT NULL CHECK (length(trim(reason)) > 0 AND length(reason) <= 500),
    status TEXT NOT NULL CHECK (status IN ('REQUESTED', 'APPROVED', 'ITEM_RETURNED', 'PROCESSING', 'PARTIALLY_REFUNDED', 'REFUNDED', 'REJECTED', 'DISPUTED')),
    requested_at INTEGER NOT NULL CHECK (requested_at >= 0),
    return_tracking TEXT CHECK (return_tracking IS NULL OR (length(trim(return_tracking)) > 0 AND length(return_tracking) <= 256)),
    refund_minor INTEGER CHECK (refund_minor IS NULL OR refund_minor >= 0),
    currency_code TEXT,
    currency_scale INTEGER CHECK (currency_scale IS NULL OR currency_scale BETWEEN 0 AND 4),
    notes TEXT CHECK (notes IS NULL OR length(notes) <= 2000),
    CHECK (status NOT IN ('PARTIALLY_REFUNDED', 'REFUNDED') OR (refund_minor IS NOT NULL AND refund_minor > 0)),
    CHECK (
        (refund_minor IS NULL AND currency_code IS NULL AND currency_scale IS NULL) OR
        (refund_minor IS NOT NULL AND currency_code IS NOT NULL AND currency_scale IS NOT NULL)
    ),
    FOREIGN KEY (order_item_id, order_id) REFERENCES order_item(id, order_id) ON DELETE CASCADE
);

CREATE INDEX order_return_order_id ON order_return(order_id, requested_at);

insertReturn:
INSERT INTO order_return VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

returnsForOrder:
SELECT * FROM order_return WHERE order_id = ? ORDER BY requested_at, id;

findReturn:
SELECT * FROM order_return WHERE id = ?;

updateReturn:
UPDATE order_return
SET status = ?, return_tracking = ?, refund_minor = ?, currency_code = ?, currency_scale = ?, notes = ?
WHERE id = ?;

allReturns:
SELECT * FROM order_return ORDER BY order_id, requested_at, id;

deleteAllReturns:
DELETE FROM order_return;

CREATE TABLE sync_meta (
    collection TEXT NOT NULL,
    id TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    origin_device TEXT NOT NULL,
    deleted_at INTEGER,
    PRIMARY KEY (collection, id)
);

CREATE INDEX sync_meta_cursor ON sync_meta(updated_at, origin_device, id);

upsertSyncMeta:
INSERT OR REPLACE INTO sync_meta VALUES (?, ?, ?, ?, ?);

findSyncMeta:
SELECT * FROM sync_meta WHERE collection = ? AND id = ?;

syncChanges:
SELECT * FROM sync_meta
WHERE collection IN :collections
  AND (updated_at > :updated_at
    OR (updated_at = :updated_at
      AND (origin_device > :origin_device
        OR (origin_device = :origin_device AND id > :id))))
ORDER BY updated_at, origin_device, id
LIMIT :limit;

deleteAllSyncMeta:
DELETE FROM sync_meta;

deleteProduct:
DELETE FROM saved_product WHERE id = ?;

deletePreference:
DELETE FROM preference WHERE key = ?;

listingsForProduct:
SELECT * FROM listing WHERE product_id = ? ORDER BY id;

observationsForListing:
SELECT * FROM price_observation WHERE listing_id = ? ORDER BY observed_at;
